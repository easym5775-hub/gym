```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*~

# OS generated files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# MyPy
.mypy_cache/

# PyTest
.pytest_cache/

# Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Distribution / packaging
*.tar.gz
*.whl

# IDE
.vs/
.project
.c9/

# Browsers
*.css.map

# TypeScript
*.tsbuildinfo
```